# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call this API (in development any localhost / LAN origin is also accepted)
CORS_ORIGIN=http://localhost:5173

# --- App database (PostgreSQL): users, saved reports, audit log, data-source registry ---
DATABASE_URL=postgresql://erp_app:erp_app_password@localhost:5432/erp_report_studio

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Credential encryption: 64 hex chars ---
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY=

# --- YOUR ERP DATABASE (read by `npm run erp:connect`) ---
# Use a READ-ONLY SQL login, not "sa". Windows Authentication is not supported.
ERP_DB_TYPE=SQL Server
ERP_DB_SERVER=192.168.1.215
ERP_DB_PORT=1433
ERP_DB_NAME=POLYDIME_ERP
ERP_DB_USER=svc_reporting
ERP_DB_PASSWORD=
ERP_DB_ENCRYPT=false
ERP_DB_TRUST_CERT=true
# Set true only for old SQL Server (2008-2014) that fails with ESOCKET / handshake errors
ERP_DB_LEGACY_TLS=false

# --- Seed / default admin user ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator
