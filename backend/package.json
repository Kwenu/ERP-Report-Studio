{
  "name": "erp-report-studio-backend",
  "version": "1.0.0",
  "description": "Backend API for ERP Report Studio - connects the report builder UI to a real database.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node src/db/seed.ts",
    "db:init": "ts-node src/db/init.ts",
    "erp:connect": "ts-node src/scripts/connectErp.ts",
    "erp:inspect": "ts-node src/scripts/inspectErp.ts",
    "erp:describe": "ts-node src/scripts/describeErp.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "erp:find": "ts-node src/scripts/findErp.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3",
    "@types/mssql": "^9.1.5"
  }
}
